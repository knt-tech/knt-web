# Contact form (SMTP) — Google Workspace / Gmail
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored, so secrets never get committed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=utarat.k@knttechsolutions.com

# Gmail/Workspace requires an App Password (NOT your normal password):
# 1. Turn on 2-Step Verification for the account.
# 2. Create one at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character value here (spaces optional).
SMTP_PASS=your-app-password-here

# Where enquiries are delivered, and the "from" address shown on the email.
# Both default to SMTP_USER if omitted.
CONTACT_TO=utarat.k@knttechsolutions.com
CONTACT_FROM=utarat.k@knttechsolutions.com
